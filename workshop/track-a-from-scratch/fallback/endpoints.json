{
  "source": "qa/01-discovery/endpoints.json",
  "match": "^EP-CART-",
  "endpoints": [
    {
      "id": "EP-CART-ADD-CART",
      "area": "CART-COMPARE-WISHLIST",
      "purpose": "Add product to cart (XHR)",
      "method": "POST",
      "path": "/cart/addproduct/{productId}/1",
      "query": [],
      "contentType": "application/x-www-form-urlencoded; charset=UTF-8",
      "bodyFields": [
        {
          "name": "addtocart_{productId}.EnteredQuantity (int 1..10000; optional, field name is not actually checked, missing/unknown field adds 1)"
        }
      ],
      "authRequired": false,
      "stateChanging": true,
      "verified": true,
      "success": {
        "status": 200,
        "location": null,
        "setCookies": [
          "SMARTSTORE.VISITOR (refreshed on every response)"
        ],
        "bodySignal": "JSON {\"success\":true} ($type AnonymousType28). Quantity is MERGED into an existing line for the same product."
      },
      "failure": {
        "status": 200,
        "bodySignal": "JSON {\"success\":false,\"message\":[\"Quantity should be positive\"]} for 0, negative, non-integer, abc, >int32; {\"message\":[\"The maximum quantity allowed for purchase is 10000.\"]} when requested or existing+requested > 10000. Unknown productId -> 200 {\"redirect\":\"/\"}. Non-numeric productId -> 404 HTML. GET -> 404 IIS page. Unknown shoppingCartType 0/-1 -> 404 HTML; 9 -> 200 success:true but nothing added; 99999999999 -> 502 Bad Gateway"
      }
    },
    {
      "id": "EP-CART-ADD-WISHLIST",
      "area": "CART-COMPARE-WISHLIST",
      "purpose": "Add product to wishlist (XHR)",
      "method": "POST",
      "path": "/cart/addproduct/{productId}/2",
      "query": [],
      "contentType": "application/x-www-form-urlencoded; charset=UTF-8",
      "bodyFields": [
        {
          "name": "addtocart_{productId}.EnteredQuantity (int 1..10000)"
        }
      ],
      "authRequired": false,
      "stateChanging": true,
      "verified": true,
      "success": {
        "status": 200,
        "location": null,
        "setCookies": [
          "SMARTSTORE.VISITOR (refreshed on every response)"
        ],
        "bodySignal": "JSON {\"success\":true}; merged into existing wishlist line. WishlistItemsCount in cartsummary = sum of quantities"
      },
      "failure": {
        "status": 200,
        "bodySignal": "Same JSON errors as add-to-cart (\"Quantity should be positive\", \"The maximum quantity allowed for purchase is 10000.\")"
      }
    },
