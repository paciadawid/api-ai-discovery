    {
      "id": "EP-CART-SUMMARY",
      "area": "CART-COMPARE-WISHLIST",
      "purpose": "Header counters JSON for cart, wishlist, compare (fired on every page)",
      "method": "POST",
      "path": "/shoppingcart/cartsummary",
      "query": [
        {
          "name": "cart",
          "example": "True"
        },
        {
          "name": "wishlist",
          "example": "True"
        },
        {
          "name": "compare",
          "example": "True"
        }
      ],
      "contentType": "none (empty body; curl needs -d '' else 411)",
      "bodyFields": [
        {
          "name": "query flags cart, wishlist, compare (any combination)"
        }
      ],
      "authRequired": false,
      "stateChanging": false,
      "verified": true,
      "success": {
        "status": 200,
        "location": null,
        "setCookies": [
          "SMARTSTORE.VISITOR (refreshed on every response)"
        ],
        "bodySignal": "JSON {\"CartItemsCount\":n,\"WishlistItemsCount\":n,\"CompareItemsCount\":n}; counts are SUM OF QUANTITIES for cart/wishlist, number of products for compare. GET returns 404"
      },
      "failure": {
        "status": 411,
        "bodySignal": "POST without Content-Length -> 411"
      }
    },
    {
      "id": "EP-CART-VIEW",
      "area": "CART-COMPARE-WISHLIST",
      "purpose": "Cart page with totals",
      "method": "GET",
      "path": "/cart",
      "query": [],
      "contentType": "-",
      "bodyFields": [],
      "authRequired": false,
      "stateChanging": false,
      "verified": true,
      "success": {
        "status": 200,
        "location": null,
        "setCookies": [
          "SMARTSTORE.VISITOR (refreshed on every response)"
        ],
        "bodySignal": "HTML. Empty: \"Your Shopping Cart is empty!\". Lines have input name=itemquantity{sciId} (form field) and data-href=/shoppingcart/updatecartitem?sciItemId={id}&isCartPage=True; totals table .cart-summary (Subtotal, Shipping, Tax, Total)"
      },
      "failure": {
        "status": 0,
        "bodySignal": "none"
      }
    },
    {
      "id": "EP-CART-UPDATE",
      "area": "CART-COMPARE-WISHLIST",
      "purpose": "Update cart or wishlist line quantity",
      "method": "POST",
      "path": "/shoppingcart/updatecartitem",
      "query": [
        {
          "name": "sciItemId",
          "example": "{sciId}"
        },
        {
          "name": "isCartPage",
          "example": "True"
        }
      ],
      "contentType": "application/x-www-form-urlencoded; charset=UTF-8",
      "bodyFields": [
        {
          "name": "newQuantity"
        },
        {
          "name": "isCartPage=true"
        },
        {
          "name": "isWishlist=true|false"
        }
      ],
      "authRequired": false,
      "stateChanging": true,
      "verified": true,
      "success": {
        "status": 200,
        "location": null,
        "setCookies": [
          "SMARTSTORE.VISITOR (refreshed on every response)"
        ],
        "bodySignal": "JSON {success:true, SubTotal:\"$50.85 excl tax\", message:[], cartHtml, totalsHtml, displayCheckoutButtons:true, newItemPrice:\"$16.95 excl tax\"}. For isWishlist=true, SubTotal/totalsHtml reflect the CART, not the wishlist (totalsHtml empty)"
      },
      "failure": {
        "status": 200,
        "bodySignal": "newQuantity>10000 -> 200 {\"success\":false,\"message\":[\"The maximum quantity allowed for purchase is 10000.\"]} (line unchanged). newQuantity<=0 (0, -1, -3) DELETES the line and then returns 500 JSON {\"error\":true,\"controller\":\"shoppingcart\",\"action\":\"updatecartitem\",\"message\":\"Object reference not set to an instance of an object.\"}. Unknown/foreign/deleted sciItemId -> same 500 JSON. newQuantity=abc, 1.5, empty or >int32 -> 502 Bad Gateway. 10000 accepted: subtotal $169,500.00"
      }
    },
    {
      "id": "EP-CART-DELETE",
      "area": "CART-COMPARE-WISHLIST",
      "purpose": "Remove cart or wishlist line",
      "method": "POST",
      "path": "/shoppingcart/deletecartitem",
      "query": [
        {
          "name": "cartItemId",
          "example": "{sciId}["
        },
        {
          "name": "wishlistItem",
          "example": "True]"
        }
      ],
      "contentType": "none (empty body)",
      "bodyFields": [
        {
          "name": "query cartItemId, wishlistItem"
        }
      ],
      "authRequired": false,
      "stateChanging": true,
      "verified": true,
      "success": {
        "status": 200,
        "location": null,
        "setCookies": [
          "SMARTSTORE.VISITOR (refreshed on every response)"
        ],
        "bodySignal": "JSON {cartItemCount:n, success:true, message:\"The product has been removed.\", cartHtml, totalsHtml, displayCheckoutButtons}"
      },
      "failure": {
        "status": 200,
        "bodySignal": "unknown/already deleted/foreign id -> 200 {\"success\":false,\"message\":\"An error occurred during the removal of the product.\"}; non-numeric or missing id -> 502; GET -> 404. Foreign (other visitor) item NOT deletable (no IDOR)"
      }
    },
